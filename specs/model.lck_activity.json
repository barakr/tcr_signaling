{
  "adapter": {
    "id": "python_cli_adapter_v1",
    "input_mapping": [
      {
        "to": {
          "key": "--cd45_boundary_density",
          "kind": "cli_arg"
        },
        "var": "cd45_boundary_density"
      },
      {
        "to": {
          "key": "--lck_decay_length",
          "kind": "cli_arg"
        },
        "var": "lck_decay_length"
      },
      {
        "to": {
          "key": "--lck_activation_rate",
          "kind": "cli_arg"
        },
        "var": "lck_activation_rate"
      },
      {
        "to": {
          "key": "--contact_radius",
          "kind": "cli_arg"
        },
        "var": "contact_radius"
      }
    ],
    "output_mapping": [
      {
        "from": {
          "kind": "file",
          "path": "out/lck_activity.json"
        },
        "var": "mean_lck_activity"
      }
    ]
  },
  "design": {
    "sobol": {
      "n_points": 64,
      "ranges": {
        "cd45_boundary_density": [
          100.0,
          1000.0
        ],
        "contact_radius": [
          0.5,
          2.0
        ],
        "lck_activation_rate": [
          0.1,
          1.0
        ],
        "lck_decay_length": [
          0.03,
          0.15
        ]
      }
    },
    "strategy": "sobol"
  },
  "io_schema": {
    "inputs": [
      {
        "name": "cd45_boundary_density",
        "support": [
          100.0,
          1000.0
        ],
        "type": "float",
        "units": "molecules/um^2"
      },
      {
        "name": "lck_decay_length",
        "support": [
          0.03,
          0.15
        ],
        "type": "float",
        "units": "um"
      },
      {
        "name": "lck_activation_rate",
        "support": [
          0.1,
          1.0
        ],
        "type": "float",
        "units": "1/s"
      },
      {
        "name": "contact_radius",
        "support": [
          0.5,
          2.0
        ],
        "type": "float",
        "units": "um"
      }
    ],
    "outputs": [
      {
        "name": "mean_lck_activity",
        "type": "float",
        "units": "a.u."
      }
    ]
  },
  "model": {
    "artifact": {
      "entrypoint": [
        "python",
        "-m",
        "projects.tcr_signaling.models.lck_activity"
      ],
      "type": "local"
    },
    "name": "lck_activity",
    "version": "0.1.0"
  },
  "reproducibility": {
    "seed": 42
  },
  "runner": {
    "mode": "local_process",
    "resources": {
      "cpus": 1,
      "mem_gb": 1,
      "walltime_min": 1
    }
  },
  "schema_version": "1.0",
  "storage": {
    "root": "store"
  }
}
