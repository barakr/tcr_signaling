{
  "adapter": {
    "id": "python_cli_adapter_v1",
    "input_mapping": [
      {
        "to": {
          "key": "--mean_lck_activity",
          "kind": "cli_arg"
        },
        "var": "mean_lck_activity"
      },
      {
        "to": {
          "key": "--tcr_density",
          "kind": "cli_arg"
        },
        "var": "tcr_density"
      },
      {
        "to": {
          "key": "--phosphorylation_rate",
          "kind": "cli_arg"
        },
        "var": "phosphorylation_rate"
      },
      {
        "to": {
          "key": "--dephosphorylation_rate",
          "kind": "cli_arg"
        },
        "var": "dephosphorylation_rate"
      }
    ],
    "output_mapping": [
      {
        "from": {
          "kind": "file",
          "path": "out/phosphorylation.json"
        },
        "var": "ptcr_fraction"
      },
      {
        "from": {
          "kind": "file",
          "path": "out/phosphorylation.json"
        },
        "var": "ptcr_density"
      }
    ]
  },
  "design": {
    "sobol": {
      "n_points": 64,
      "ranges": {
        "dephosphorylation_rate": [
          0.01,
          1.0
        ],
        "mean_lck_activity": [
          0.0,
          500.0
        ],
        "phosphorylation_rate": [
          0.01,
          0.5
        ],
        "tcr_density": [
          50.0,
          300.0
        ]
      }
    },
    "strategy": "sobol"
  },
  "io_schema": {
    "inputs": [
      {
        "name": "mean_lck_activity",
        "support": [
          0.0,
          500.0
        ],
        "type": "float",
        "units": "a.u."
      },
      {
        "name": "tcr_density",
        "support": [
          50.0,
          300.0
        ],
        "type": "float",
        "units": "molecules/um^2"
      },
      {
        "name": "phosphorylation_rate",
        "support": [
          0.01,
          0.5
        ],
        "type": "float",
        "units": "1/s"
      },
      {
        "name": "dephosphorylation_rate",
        "support": [
          0.01,
          1.0
        ],
        "type": "float",
        "units": "1/s"
      }
    ],
    "outputs": [
      {
        "name": "ptcr_fraction",
        "type": "float",
        "units": "a.u."
      },
      {
        "name": "ptcr_density",
        "type": "float",
        "units": "molecules/um^2"
      }
    ]
  },
  "model": {
    "artifact": {
      "entrypoint": [
        "python",
        "-m",
        "projects.tcr_signaling.models.tcr_phosphorylation"
      ],
      "type": "local"
    },
    "name": "tcr_phosphorylation",
    "version": "0.1.0"
  },
  "reproducibility": {
    "seed": 42
  },
  "runner": {
    "mode": "local_process",
    "resources": {
      "cpus": 1,
      "mem_gb": 1,
      "walltime_min": 1
    }
  },
  "schema_version": "1.0",
  "storage": {
    "root": "store"
  }
}
