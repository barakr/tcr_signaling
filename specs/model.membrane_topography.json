{
  "adapter": {
    "id": "python_cli_adapter_v1",
    "input_mapping": [
      {
        "to": {
          "key": "--contact_radius",
          "kind": "cli_arg"
        },
        "var": "contact_radius"
      },
      {
        "to": {
          "key": "--patch_size",
          "kind": "cli_arg"
        },
        "var": "patch_size"
      }
    ],
    "output_mapping": [
      {
        "from": {
          "kind": "file",
          "path": "out/topography.json"
        },
        "var": "contact_fraction"
      },
      {
        "from": {
          "kind": "file",
          "path": "out/topography.json"
        },
        "var": "contact_perimeter_um"
      }
    ]
  },
  "design": {
    "grid": {
      "contact_radius": [
        0.5,
        0.75,
        1.0,
        1.25,
        1.5,
        1.75,
        2.0
      ],
      "patch_size": [
        2.0,
        3.0,
        4.0
      ]
    },
    "strategy": "grid"
  },
  "io_schema": {
    "inputs": [
      {
        "name": "contact_radius",
        "support": [
          0.5,
          2.0
        ],
        "type": "float",
        "units": "um"
      },
      {
        "name": "patch_size",
        "support": [
          2.0,
          4.0
        ],
        "type": "float",
        "units": "um"
      }
    ],
    "outputs": [
      {
        "name": "contact_fraction",
        "type": "float",
        "units": "a.u."
      },
      {
        "name": "contact_perimeter_um",
        "type": "float",
        "units": "um"
      }
    ]
  },
  "model": {
    "artifact": {
      "entrypoint": [
        "python",
        "-m",
        "projects.tcr_signaling.models.membrane_topography"
      ],
      "type": "local"
    },
    "name": "membrane_topography",
    "version": "0.1.0"
  },
  "reproducibility": {
    "seed": 42
  },
  "runner": {
    "mode": "local_process",
    "resources": {
      "cpus": 1,
      "mem_gb": 1,
      "walltime_min": 1
    }
  },
  "schema_version": "1.0",
  "storage": {
    "root": "store"
  }
}
